.hotspot-btn {
  position: absolute;
  width: 40px;
  height: 40px;
  background: color-mix(in oklab, var(--body-bg) 60%, transparent);
  border: 3px solid var(--body-color);
  border-radius: 50%;
  outline: none;
  color: var(--body-color);
}
.hotspot-btn:hover {
  color: var(--body-bg);
  border-color: var(--body-bg);
  background: color-mix(in oklab, var(--body-color) 60%, transparent);
}

.hotspot-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
