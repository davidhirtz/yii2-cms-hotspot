{
  "name": "davidhirtz/yii2-cms-hotspot",
  "description": "Image hotspot module for content management system based on Yii 2.0 framework",
  "license": "proprietary",
  "type": "yii2-extension",
  "homepage": "https://www.github.com/davidhirtz/yii2-cms-hotspot",
  "authors": [
    {
      "name": "David Hirtz",
      "homepage": "https://www.davidhirtz.com/"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.3",
    "davidhirtz/yii2-cms": "next-dev"
  },
  "require-dev": {
  },
  "autoload": {
    "psr-4": {
      "Hirtz\\Cms\\Hotspot\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Hirtz\\Cms\\Hotspot\\Tests\\": "tests"
    }
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "phpro/grumphp-shim": true
    }
  },
  "extra": {
    "bootstrap": "Hirtz\\Cms\\Hotspot\\Bootstrap"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ],
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G",
    "rector": "rector",
    "test": "codecept run"
  }
}
